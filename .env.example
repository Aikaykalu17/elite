# Copy to .env.local for local development, and set the same names in your
# hosting dashboard (e.g. Vercel > Settings > Environment Variables).

# Required: API key from https://resend.com (applications cannot be sent without it).
RESEND_API_KEY=

# Optional: where trial applications are emailed.
# Defaults to the address previously hard-coded in the project.
APPLICATIONS_TO_EMAIL=

# Optional: the "from" address. Defaults to Resend's shared test sender, which
# can only deliver to the email address that owns your Resend account.
# Verify your own domain in Resend, then set e.g. "Elite FC <applications@yourdomain.com>".
APPLICATIONS_FROM_EMAIL=
